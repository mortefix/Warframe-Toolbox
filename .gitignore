# User data — NEVER commit (contains the warframe.market JWT).
# Default data root is %LOCALAPPDATA%\WarframeToolbox (outside the repo);
# userdata/ is the opt-in portable-data override used by dev clones.
userdata/

# Legacy runtime-data locations (pre-restructure trees; safety net)
data/.*
data/launch-error.log
app/.*
app/launch-error.log
.wftoolbox.lock
launch-error.log

# Python
__pycache__/
*.py[cod]

# Dev-only — kept on the `dev-tools` branch, excluded from the lean `main`.
# These still exist on disk; they're just not tracked on the runtime branch.
# (Installer source, build docs, tests, CI, dev docs, AI planning artifacts,
# screenshot helpers, legacy batch helpers.)
/tools/
/tests/
/docs/*
!/docs/default-settings.json
/.github/
/CLAUDE.md
/uninstall.bat
/update.bat
